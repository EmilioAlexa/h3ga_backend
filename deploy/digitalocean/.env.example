# Reference template only. Do not copy over an existing Droplet .env.
NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://DOMINIO_REAL.netlify.app

# Use the Managed PostgreSQL connection string for h3ga_finanzas_v1.
# Keep these verified TLS options for Prisma CLI. The running API uses the CA file
# below directly with certificate validation enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/h3ga_finanzas_v1?schema=public&sslmode=verify-full&sslrootcert=%2Fetc%2Fh3ga%2Fpostgresql-ca.crt
DATABASE_SSL_CA_FILE=/etc/h3ga/postgresql-ca.crt
# Leave unset unless Prisma migration workflows explicitly require a separate DB.
# Never point this at the primary database.
# SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@SEPARATE_HOST:25060/SEPARATE_SHADOW_DB?schema=public

JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1h
RESET_CODE_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
SWAGGER_ENABLED=false

# Evidence storage; keep this provider independent from contract documents.
STORAGE_PROVIDER=s3
LOCAL_STORAGE_PATH=/opt/h3ga/h3ga_backend/storage/evidencias
MAX_FILE_SIZE_MB=10
S3_ENDPOINT=https://REGION.digitaloceanspaces.com
S3_REGION=REGION
S3_BUCKET=PRIVATE_EVIDENCE_BUCKET
S3_ACCESS_KEY=REPLACE_OUTSIDE_REPOSITORY
S3_SECRET_KEY=REPLACE_OUTSIDE_REPOSITORY

# Contract document storage; use a separate private bucket and credentials.
CONTRACT_STORAGE_PROVIDER=s3
CONTRACT_LOCAL_STORAGE_PATH=/opt/h3ga/h3ga_backend/storage/contratos
CONTRACT_S3_ENDPOINT=https://REGION.digitaloceanspaces.com
CONTRACT_S3_REGION=REGION
CONTRACT_S3_BUCKET=PRIVATE_CONTRACT_BUCKET
CONTRACT_S3_ACCESS_KEY=REPLACE_OUTSIDE_REPOSITORY
CONTRACT_S3_SECRET_KEY=REPLACE_OUTSIDE_REPOSITORY

# Required if password-reset email is enabled in the deployed application.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_OUTSIDE_REPOSITORY
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER
