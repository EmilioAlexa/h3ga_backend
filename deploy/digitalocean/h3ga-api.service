[Unit]
Description=H3GA Finanzas NestJS API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=h3ga
Group=h3ga
WorkingDirectory=/opt/h3ga/h3ga_backend
EnvironmentFile=/opt/h3ga/h3ga_backend/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/opt/h3ga/node24/bin/node /opt/h3ga/h3ga_backend/dist/main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/h3ga/h3ga_backend/storage
UMask=0077

[Install]
WantedBy=multi-user.target
