generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model clientes {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grupo_principal_id            Int?                            @db.SmallInt
  nombre                        String
  apellido_paterno              String
  apellido_materno              String?
  referido_por                  String?
  telefono                      String?
  asesor_id                     String?                         @db.Uuid
  fecha_ingreso                 DateTime?                       @db.Date
  correo_electronico            String?
  curp                          String?                         @db.VarChar(18)
  rfc                           String?                         @db.VarChar(13)
  fecha_nacimiento              DateTime?                       @db.Date
  estado_civil                  String?
  dependientes_economicos       Int?
  regimen_id                    Int?                            @db.SmallInt
  nss                           String?                         @db.VarChar(11)
  ley_probable_id               Int?                            @db.SmallInt
  semanas_imss_reconocidas      Int?
  semanas_a_recuperar           Int?
  tiene_issste                  String?
  afore_id                      Int?                            @db.SmallInt
  observaciones_generales       String?
  requiere_contadora            String?
  sexo                          String?
  ocupacion                     String?
  domicilio                     String?
  estado                        String?
  subdelegacion_imss_probable   String?
  cambio_afore                  String?
  ine                           String?                         @db.VarChar(18)
  objetivo_cliente              String?
  cliente_objetivos_especificos cliente_objetivos_especificos[]
  afore                         afore?                          @relation(fields: [afore_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_clientes_afore")
  usuarios                      usuarios?                       @relation(fields: [asesor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_clientes_asesor")
  grupos_principales            grupos_principales?             @relation(fields: [grupo_principal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_clientes_grupo_principal")
  ley_probable                  ley_probable?                   @relation(fields: [ley_probable_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_clientes_ley_probable")
  regimen_principal             regimen_principal?              @relation(fields: [regimen_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_clientes_regimen")
  contratos                     contratos[]
  correcciones_cliente          correcciones_cliente[]
  credenciales_correo_cliente   credenciales_correo_cliente?
  diagnostico_especializado     diagnostico_especializado?
  documentos_clientes           documentos_clientes[]
  etapas_tramite                etapas_tramite[]
  eventos_agenda                eventos_agenda[]
  historial_laboral             historial_laboral?
  informacion_fiscal            informacion_fiscal?
  modalidades_aplicacion        modalidades_aplicacion[]
  periodos_inconsistencias      periodos_inconsistencias[]
}

model comisiones {
  id                             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pago_id                        String                       @db.Uuid
  beneficiario_id                String?                      @db.Uuid
  monto_base                     Decimal                      @db.Decimal(12, 2)
  monto_comision                 Decimal                      @db.Decimal(12, 2)
  estado_id                      Int                          @db.SmallInt
  fecha_calculo                  DateTime                     @default(now()) @db.Timestamptz(6)
  observaciones                  String?
  concepto_id                    Int                          @db.SmallInt
  tipo_calculo                   tipo_calculo_dispersion
  valor_aplicado                 Decimal                      @db.Decimal(12, 2)
  contrato_dispersion_detalle_id String?                      @db.Uuid
  detalle_prenomina_id           String?                      @db.Uuid
  conceptos_dispersion           conceptos_dispersion         @relation(fields: [concepto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contrato_dispersion_detalle    contrato_dispersion_detalle? @relation(fields: [contrato_dispersion_detalle_id], references: [id], onUpdate: NoAction)
  detalle_prenomina              detalle_prenomina?           @relation(fields: [detalle_prenomina_id], references: [id], onUpdate: NoAction)
  usuarios                       usuarios?                    @relation(fields: [beneficiario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comisiones_asesor")
  estados_comisiones             estados_comisiones           @relation(fields: [estado_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comisiones_estado")
  pagos                          pagos                        @relation(fields: [pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comisiones_pago")

  @@unique([pago_id, concepto_id], map: "uq_comisiones_pago_concepto")
  @@index([beneficiario_id], map: "ix_comisiones_beneficiario")
  @@index([concepto_id], map: "ix_comisiones_concepto")
  @@index([detalle_prenomina_id], map: "ix_comisiones_prenomina")
}

model contratos {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id                  String                        @db.Uuid
  servicio_id                 Int                           @db.SmallInt
  asesor_id                   String                        @db.Uuid
  folio                       String                        @db.VarChar(50)
  fecha_contrato              DateTime                      @db.Date
  estado_contrato_id          Int                           @db.SmallInt
  cantidad_pagos              Int?                          @db.SmallInt
  observaciones               String?
  creado_en                   DateTime                      @default(now()) @db.Timestamptz(6)
  contrato_dispersion_detalle contrato_dispersion_detalle[]
  usuarios                    usuarios                      @relation(fields: [asesor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_contratos_asesor")
  clientes                    clientes                      @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_contratos_cliente")
  estados_contratos           estados_contratos             @relation(fields: [estado_contrato_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_contratos_estado")
  servicios                   servicios                     @relation(fields: [servicio_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_contratos_servicio")
  pagos                       pagos[]
  pagos_programados           pagos_programados[]
  seguimiento_apd             seguimiento_apd?
  seguimiento_m10             seguimiento_m10?
  seguimiento_m40             seguimiento_m40?
  seguimiento_m40_retroactiva seguimiento_m40_retroactiva?
}

model cortes_financieros {
  id                                                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero_corte                                      Int
  fecha_inicio                                      DateTime        @db.Timestamptz(6)
  fecha_fin                                         DateTime        @db.Timestamptz(6)
  estado_id                                         Int             @db.SmallInt
  creado_por                                        String          @db.Uuid
  creado_en                                         DateTime        @default(now()) @db.Timestamptz(6)
  cerrado_por                                       String?         @db.Uuid
  cerrado_en                                        DateTime?       @db.Timestamptz(6)
  usuarios_cortes_financieros_cerrado_porTousuarios usuarios?       @relation("cortes_financieros_cerrado_porTousuarios", fields: [cerrado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cortes_cerrado_por")
  usuarios_cortes_financieros_creado_porTousuarios  usuarios        @relation("cortes_financieros_creado_porTousuarios", fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cortes_creado_por")
  estados_corte                                     estados_corte   @relation(fields: [estado_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cortes_estado")
  detalle_corte                                     detalle_corte[]
  prenomina                                         prenomina[]
}

model detalle_corte {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corte_id           String             @db.Uuid
  pago_id            String             @db.Uuid
  monto              Decimal            @db.Decimal(12, 2)
  cortes_financieros cortes_financieros @relation(fields: [corte_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_detalle_corte")
  pagos              pagos              @relation(fields: [pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_corte_pago")

  @@unique([corte_id, pago_id], map: "uq_detalle_corte_pago")
}

model detalle_prenomina {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prenomina_id      String       @db.Uuid
  beneficiario_id   String       @db.Uuid
  monto_referencial Decimal?     @db.Decimal(12, 2)
  observaciones     String?
  comisiones        comisiones[]
  prenomina         prenomina    @relation(fields: [prenomina_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_detalle_prenomina")
  usuarios          usuarios     @relation(fields: [beneficiario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_prenomina_asesor")
}

model estados_comisiones {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  nombre      String       @unique @db.VarChar(30)
  descripcion String?
  comisiones  comisiones[]
}

model estados_contratos {
  id          Int         @id @default(autoincrement()) @db.SmallInt
  nombre      String      @unique @db.VarChar(50)
  descripcion String?
  orden       Int         @db.SmallInt
  contratos   contratos[]
}

model estados_corte {
  id                 Int                  @id @default(autoincrement()) @db.SmallInt
  nombre             String               @unique @db.VarChar(20)
  descripcion        String?
  cortes_financieros cortes_financieros[]
}

model estados_pago {
  id                                                                             Int                      @id @default(autoincrement()) @db.SmallInt
  nombre                                                                         String                   @unique @db.VarChar(50)
  orden                                                                          Int                      @db.SmallInt
  historial_estados_pago_historial_estados_pago_estado_anterior_idToestados_pago historial_estados_pago[] @relation("historial_estados_pago_estado_anterior_idToestados_pago")
  historial_estados_pago_historial_estados_pago_estado_nuevo_idToestados_pago    historial_estados_pago[] @relation("historial_estados_pago_estado_nuevo_idToestados_pago")
  pagos                                                                          pagos[]
}

model estados_pago_programado {
  id                Int                 @id @default(autoincrement()) @db.SmallInt
  nombre            String              @unique @db.VarChar(30)
  descripcion       String?
  pagos_programados pagos_programados[]
}

model estados_prenomina {
  id          Int         @id @default(autoincrement()) @db.SmallInt
  nombre      String      @unique @db.VarChar(30)
  descripcion String?
  prenomina   prenomina[]
}

model evidencias_pago {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pago_id              String                @db.Uuid
  tipo_evidencia_id    Int?                  @db.SmallInt
  archivo_path         String
  nombre_original      String?
  tipo_archivo         String?
  subido_por           String?               @db.Uuid
  fecha_carga          DateTime              @default(now()) @db.Timestamptz(6)
  hash_archivo         String?               @db.VarChar(128)
  pagos                pagos                 @relation(fields: [pago_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evidencias_pago")
  tipos_evidencia_pago tipos_evidencia_pago? @relation(fields: [tipo_evidencia_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_evidencias_tipo")
  usuarios             usuarios?             @relation(fields: [subido_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_evidencias_usuario")
}

model formas_pago {
  id     Int     @id @default(autoincrement()) @db.SmallInt
  nombre String  @unique @db.VarChar(50)
  activo Boolean @default(true)
  pagos  pagos[]
}

model historial_estados_pago {
  id                                                                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pago_id                                                              String        @db.Uuid
  estado_anterior_id                                                   Int?          @db.SmallInt
  estado_nuevo_id                                                      Int?          @db.SmallInt
  cambiado_por                                                         String?       @db.Uuid
  fecha_cambio                                                         DateTime      @default(now()) @db.Timestamptz(6)
  comentario                                                           String?
  estados_pago_historial_estados_pago_estado_anterior_idToestados_pago estados_pago? @relation("historial_estados_pago_estado_anterior_idToestados_pago", fields: [estado_anterior_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_historial_estado_anterior")
  estados_pago_historial_estados_pago_estado_nuevo_idToestados_pago    estados_pago? @relation("historial_estados_pago_estado_nuevo_idToestados_pago", fields: [estado_nuevo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_historial_estado_nuevo")
  pagos                                                                pagos         @relation(fields: [pago_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_historial_pago")
  usuarios                                                             usuarios?     @relation(fields: [cambiado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_historial_usuario")
}

model modalidades_apd {
  id              Int               @id @default(autoincrement()) @db.SmallInt
  nombre          String            @unique @db.VarChar(50)
  descripcion     String?
  activo          Boolean           @default(true)
  seguimiento_apd seguimiento_apd[]
}

model pagos {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contrato_id            String                   @db.Uuid
  pago_programado_id     String?                  @db.Uuid
  forma_pago_id          Int?                     @db.SmallInt
  estado_pago_id         Int?                     @db.SmallInt
  monto                  Decimal                  @db.Decimal(12, 2)
  fecha_pago             DateTime?                @db.Timestamptz(6)
  registrado_por         String?                  @db.Uuid
  fecha_registro         DateTime                 @default(now()) @db.Timestamptz(6)
  observaciones          String?
  referencia_pago        String?                  @db.VarChar(100)
  comisiones             comisiones[]
  detalle_corte          detalle_corte[]
  evidencias_pago        evidencias_pago[]
  historial_estados_pago historial_estados_pago[]
  contratos              contratos                @relation(fields: [contrato_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pagos_contrato")
  estados_pago           estados_pago?            @relation(fields: [estado_pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pagos_estado")
  formas_pago            formas_pago?             @relation(fields: [forma_pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pagos_forma")
  pagos_programados      pagos_programados?       @relation(fields: [pago_programado_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pagos_programado")
  usuarios               usuarios?                @relation(fields: [registrado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pagos_usuario")
}

model pagos_programados {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contrato_id             String                   @db.Uuid
  tipo_cobro_id           Int?                     @db.SmallInt
  numero_pago             Int
  fecha_esperada          DateTime?                @db.Date
  fecha_vencimiento       DateTime?                @db.Date
  monto_esperado          Decimal?                 @db.Decimal(12, 2)
  periodo                 DateTime?                @db.Date
  estado_id               Int?                     @db.SmallInt
  pagos                   pagos[]
  contratos               contratos                @relation(fields: [contrato_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pagos_programados_contrato")
  estados_pago_programado estados_pago_programado? @relation(fields: [estado_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pagos_programados_estado")
  tipos_cobro             tipos_cobro?             @relation(fields: [tipo_cobro_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pagos_programados_tipo_cobro")
}

model prenomina {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corte_id           String              @db.Uuid
  estado_id          Int                 @db.SmallInt
  creado_por         String              @db.Uuid
  creado_en          DateTime            @default(now()) @db.Timestamptz(6)
  total_referencial  Decimal?            @db.Decimal(12, 2)
  observaciones      String?
  detalle_prenomina  detalle_prenomina[]
  cortes_financieros cortes_financieros  @relation(fields: [corte_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_prenomina_corte")
  estados_prenomina  estados_prenomina   @relation(fields: [estado_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_prenomina_estado")
  usuarios           usuarios            @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_prenomina_usuario")
}

model proveedores {
  id              Int               @id @default(autoincrement()) @db.SmallInt
  nombre          String            @unique @db.VarChar(100)
  descripcion     String?
  activo          Boolean           @default(true)
  seguimiento_apd seguimiento_apd[]
}

model roles {
  id          Int        @id @default(autoincrement()) @db.SmallInt
  nombre      String     @unique
  descripcion String?
  usuarios    usuarios[]
}

model seguimiento_apd {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contrato_id              String           @unique(map: "uq_seguimiento_apd_contrato") @db.Uuid
  tipo_venta_id            Int?             @db.SmallInt
  modalidad_apd_id         Int?             @db.SmallInt
  proveedor_id             Int?             @db.SmallInt
  fecha_alta               DateTime?        @db.Date
  fecha_baja               DateTime?        @db.Date
  fecha_reingreso          DateTime?        @db.Date
  fecha_alta_reingreso     DateTime?        @db.Date
  fecha_baja_reingreso     DateTime?        @db.Date
  fecha_solicitud_recursos DateTime?        @db.Date
  fecha_reflejo_recursos   DateTime?        @db.Date
  monto_recurso_cliente    Decimal?         @db.Decimal(12, 2)
  porcentaje_cobro         Decimal?         @db.Decimal(5, 2)
  monto_cobro_esperado     Decimal?         @db.Decimal(12, 2)
  fecha_cobro_cliente      DateTime?        @db.Date
  observaciones            String?
  contratos                contratos        @relation(fields: [contrato_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_seguimiento_apd_contrato")
  modalidades_apd          modalidades_apd? @relation(fields: [modalidad_apd_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_seguimiento_apd_modalidad")
  proveedores              proveedores?     @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_seguimiento_apd_proveedor")
  tipos_venta              tipos_venta?     @relation(fields: [tipo_venta_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_seguimiento_apd_tipo_venta")
}

model seguimiento_m10 {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contrato_id            String    @unique(map: "uq_seguimiento_m10_contrato") @db.Uuid
  fecha_inicio_tramite   DateTime? @db.Date
  fecha_tramite_pago     DateTime? @db.Date
  monto_pago_inscripcion Decimal?  @db.Decimal(12, 2)
  monto_mensual          Decimal?  @db.Decimal(12, 2)
  periodo_contrato       String?
  observaciones          String?
  contratos              contratos @relation(fields: [contrato_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_seguimiento_m10_contrato")
}

model seguimiento_m40 {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contrato_id    String    @unique(map: "uq_seguimiento_m40_contrato") @db.Uuid
  fecha_inicio   DateTime? @db.Date
  fecha_fin      DateTime? @db.Date
  salario_diario Decimal?  @db.Decimal(10, 2)
  cantidad_meses Int?      @db.SmallInt
  monto_mensual  Decimal?  @db.Decimal(12, 2)
  observaciones  String?
  contratos      contratos @relation(fields: [contrato_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_seguimiento_m40_contrato")
}

model seguimiento_m40_retroactiva {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contrato_id              String    @unique(map: "uq_seguimiento_m40_retroactiva_contrato") @db.Uuid
  fecha_solicitud          DateTime? @db.Date
  fecha_inicio_retroactivo DateTime? @db.Date
  fecha_fin_retroactivo    DateTime? @db.Date
  meses_retroactivos       Int?      @db.SmallInt
  salario_diario           Decimal?  @db.Decimal(10, 2)
  monto_estimado           Decimal?  @db.Decimal(12, 2)
  monto_confirmado         Decimal?  @db.Decimal(12, 2)
  observaciones            String?
  contratos                contratos @relation(fields: [contrato_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_seguimiento_m40_retroactiva_contrato")
}

model servicios {
  id                  Int                   @id @default(autoincrement()) @db.SmallInt
  nombre              String                @unique
  descripcion         String?
  activo              Boolean               @default(true)
  contratos           contratos[]
  esquemas_dispersion esquemas_dispersion[]
}

model tipos_asesor {
  id                                Int                                 @id @default(autoincrement()) @db.SmallInt
  nombre                            String                              @unique @db.VarChar(50)
  descripcion                       String?
  activo                            Boolean                             @default(true)
  configuracion_comisiones_obsoleta configuracion_comisiones_obsoleta[]
  esquemas_dispersion               esquemas_dispersion[]
}

model tipos_cobro {
  id                Int                 @id @default(autoincrement()) @db.SmallInt
  nombre            String              @unique @db.VarChar(50)
  descripcion       String?
  activo            Boolean             @default(true)
  pagos_programados pagos_programados[]
}

model tipos_evidencia_pago {
  id              Int               @id @default(autoincrement()) @db.SmallInt
  nombre          String            @unique @db.VarChar(50)
  descripcion     String?
  evidencias_pago evidencias_pago[]
}

model tipos_venta {
  id              Int               @id @default(autoincrement()) @db.SmallInt
  nombre          String            @unique @db.VarChar(50)
  descripcion     String?
  activo          Boolean           @default(true)
  seguimiento_apd seguimiento_apd[]
}

model usuarios {
  id                                                                                String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rol_id                                                                            Int                                 @db.SmallInt
  nombre                                                                            String
  apellido_paterno                                                                  String
  apellido_materno                                                                  String?
  correo_electronico                                                                String                              @unique
  activo                                                                            Boolean                             @default(true)
  fecha_creacion                                                                    DateTime                            @default(now()) @db.Timestamptz(6)
  password_hash                                                                     String?
  avisos                                                                            avisos[]
  clientes                                                                          clientes[]
