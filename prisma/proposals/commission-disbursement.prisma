// Fragmento histórico de la propuesta I5. El modelo final ya está en schema.prisma.
// La migración correspondiente se aplicó únicamente a PostgreSQL Test con autorización.
model dispersiones_comision {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comision_id              String    @unique(map: "uq_dispersiones_comision") @db.Uuid
  idempotency_key          String    @unique(map: "uq_dispersiones_idempotency_key") @db.Uuid
  referencia_transferencia String    @db.VarChar(120)
  confirmado_por           String    @db.Uuid
  confirmado_en            DateTime  @default(now()) @db.Timestamptz(6)
  comprobante_path         String
  comprobante_sha256       String    @db.Char(64)
  comprobante_tamano_bytes Int
  comisiones               comisiones @relation(fields: [comision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios                 usuarios   @relation(fields: [confirmado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([confirmado_en], map: "ix_dispersiones_confirmado_en")
}
