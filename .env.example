NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/h3ga?schema=public"

JWT_SECRET="CHANGE_THIS_SECRET"
JWT_EXPIRES_IN="1h"

# Activar la documentación interactiva solo en entornos autorizados.
SWAGGER_ENABLED=false

# Evidencias de pago: almacenamiento privado local (sin ruta pública estática).
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/evidencias
MAX_FILE_SIZE_MB=10

# Para Spaces/S3, configurar estas variables solo cuando el proveedor se implemente.
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
