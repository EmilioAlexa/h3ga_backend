NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/h3ga_finanzas_test?schema=public"

JWT_SECRET="CHANGE_THIS_SECRET"
JWT_EXPIRES_IN="1h"

# Activar la documentación interactiva solo en entornos autorizados.
SWAGGER_ENABLED=false

# Evidencias de pago: almacenamiento privado local (sin ruta pública estática).
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/evidencias
MAX_FILE_SIZE_MB=10

# Adaptador privado Spaces/S3 preparado. Configurar solo tras autorización explícita;
# usar endpoint HTTPS y bucket privado existente. Mantener local durante integración sin Spaces.
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# RESET_CODE_SECRET= 


# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=empresa_correo@gmail.com
# SMTP_PASSWORD=empresa_contrasena
# SMTP_FROM=tu_correo@gmail.com


# Documentos contractuales independientes de las evidencias historicas.
CONTRACT_STORAGE_PROVIDER=local
CONTRACT_LOCAL_STORAGE_PATH=./storage/contratos
# Activar solo con autorizacion y bucket privado previamente verificado.
# CONTRACT_STORAGE_PROVIDER=s3
# CONTRACT_S3_ENDPOINT=https://REGION.digitaloceanspaces.com
# CONTRACT_S3_REGION=REGION
# CONTRACT_S3_BUCKET=PRIVATE_BUCKET_NAME
# CONTRACT_S3_ACCESS_KEY=REPLACE_OUTSIDE_REPOSITORY
# CONTRACT_S3_SECRET_KEY=REPLACE_OUTSIDE_REPOSITORY
